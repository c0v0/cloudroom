# CloudRoom 服务端配置模板（生产用）
# 复制到 /etc/cloudroom/config.toml 后按需修改：
#   sudo cp config.toml.example /etc/cloudroom/config.toml
#   sudo chown root:cloudroom /etc/cloudroom/config.toml
#   sudo chmod 0640 /etc/cloudroom/config.toml
# 每个键的含义和默认值见 `release/deployment-zh.md` 第三节或 docs/configuration.md。

[server]
# 后端只监听回环/Unix socket，公网 TLS 由 Nginx 终止，禁止改成公网地址。
listen = "127.0.0.1:8080"
# 浏览器访问的地址（必须与 Nginx server_name 一致）。
public_origin = "https://chat.example.com"
# 前端所在 origin；前后端同域部署时与 public_origin 相同（推荐）。
frontend_origin = "https://chat.example.com"
# 前端与 API 不同站（例如 https://app.example.com 调 https://api.example.com）
# 时设为 true；会使用 SameSite=None Cookie，必须保持 insecure_cookies=false。
cross_site_cookies = false
# 允许设置 X-Forwarded-For 的精确 TCP 对端（本机 Nginx）。
# 后端会校验实际 peer；不匹配时忽略该头并使用连接地址。
trusted_proxy = "127.0.0.1"
# 生产必须保持 false（Secure cookie 依赖 https）。
insecure_cookies = false
# 生产默认 false；只有本地/测试才显式改为 true（允许 http/ws 与自签测试配置）。
development = false
# 额外允许的跨域 origin（前端独立域名时才需要）。
# allowed_origins = ["https://app.example.com"]

[data]
# 数据目录：SQLite、头像、备份。属主 cloudroom，权限 0750。
dir = "/var/lib/cloudroom"

[auth]
# invite_only = 管理员发注册邀请；open = 公开注册（不推荐）。
registration_mode = "invite_only"
# 会话有效期。
session_ttl = "30d"
# 首次引导 bootstrap 链接有效期。
bootstrap_ttl = "24h"

[rooms]
# 私聊房间：任一方连续离线超过该时长则删除（默认 1 小时）。
dm_idle_timeout = "1h"
# 删除/过期房间的数据保留期，之后物理清理（房间号永久作废不复用）。
expired_cleanup_grace = "30d"
# 自动房间号长度。修改只影响之后新建的房间，旧房间号不变。
generated_code_length = 7
# 自动房间号字符集（小写 Crockford Base32，无 i l o u）。
generated_code_alphabet = "0123456789abcdefghjkmnpqrstvwxyz"
# 自定义房间号保留词（与前端路由冲突的词），可追加。
# reserved_codes = ["api", "admin", "register", "health", "ws", "login"]

[media]
# LiveKit 是唯一的媒体基础设施（P2P 内嵌 TURN 与 SFU 转发都依赖它）。
# 与 /etc/livekit.yaml 的 keys 完全一致；密钥只存在服务端，浏览器只拿短期凭证。
livekit_url = "wss://lk.example.com"
livekit_api_url = "http://127.0.0.1:7880"
livekit_api_key = "CHANGE_ME"
livekit_api_secret = "CHANGE_ME"
# P2P 房间语音上限，超过时加入语音返回 sfu_required（可申请切换 SFU 模式）。
p2p_voice_max_participants = 4

[security]
# 头像限制：2 MiB、最大 1024x1024、仅 PNG/JPEG/WebP。
max_avatar_bytes = 2097152
max_avatar_dimension = 1024
# 房间内昵称长度上限。
max_nickname_graphemes = 32
# LiveKit 媒体 JWT 有效期。
media_token_ttl = "10m"
# WebSocket 资源上限（超限关闭连接并记录）。
ws_max_message_bytes = 65536
ws_queue_messages = 128
ws_events_per_second = 30
ws_max_connections_per_user = 4
ws_max_connections_total = 1024

[rate_limit]
# Optional; defaults are shown in docs/configuration.md.
avatar_per_minute_per_user = 10
ice_servers_per_minute_per_user = 30
media_token_per_minute_per_user = 30
direct_room_per_hour_per_user = 20
avatar_read_per_minute_per_user = 600
password_change_per_minute_per_user = 5
ws_upgrade_per_minute_per_user = 30

[log]
level = "info"

[push]
# Web Push（VAPID）。两个密钥都为空时功能关闭，前端不显示"后台推送"开关。
# vapid_private_key 是 PKCS#8 DER 的 base64（标准 base64，非 URL 安全）。
# 生成：openssl ecparam -genkey -name prime256v1 | openssl pkcs8 -topk8 -nocrypt -outform DER | base64 -w0
# 公钥可由私钥推导，但建议显式填写（base64url 无填充的 65 字节未压缩点）。
vapid_public_key = ""
vapid_private_key = ""
subject = "mailto:admin@example.com"
