# CloudRoom server systemd unit (example)
# Hardened: non-root service user, loopback-only listener, restricted
# filesystem access, no privilege escalation.
#
# Install: sudo install -m 0640 release/systemd/cloudroom-server.service /etc/systemd/system/
# Then:    sudo systemctl daemon-reload && sudo systemctl enable --now cloudroom-server
#
# Logs:    journalctl -u cloudroom-server -f

[Unit]
Description=CloudRoom real-time room server
Documentation=https://github.com/your-org/cloudroom
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=cloudroom
Group=cloudroom

# The binary is statically linked (musl) and has no runtime dependencies.
ExecStart=/usr/local/bin/cloudroom-server --config /etc/cloudroom/config.toml
# No ExecReload: the server handles SIGTERM only. Use `systemctl restart`
# (or stop/start); a SIGHUP-based hot reload is not implemented.

# Backend listens only on loopback or a Unix socket; Nginx terminates TLS.
# (No public interface is ever bound.)

# Runtime directory (0770, owned by cloudroom), cleaned automatically.
RuntimeDirectory=cloudroom
RuntimeDirectoryMode=0750
UMask=0077

# Read-only root filesystem; only the data + runtime dirs are writable.
ProtectSystem=strict
ReadWritePaths=/var/lib/cloudroom /run/cloudroom

# Data directory and permissions.
StateDirectory=cloudroom
StateDirectoryMode=0750

# Hardening.
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectHome=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
ProcSubset=pid
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
SystemCallArchitectures=native
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# The server must not execute other binaries.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
CapabilityBoundingSet=
AmbientCapabilities=
DevicePolicy=closed

# Resource limits.
LimitNOFILE=65536
# 与 tokio 阻塞线程池上限（512）拉开距离，避免建线程 EPERM。
LimitNPROC=4096
TasksMax=4096

# 需要提高日志级别时用独立 env 文件，避免改 root 所有的配置文件。
EnvironmentFile=-/etc/cloudroom/env
Environment=RUST_LOG=info

# Restart policy.
Restart=on-failure
RestartSec=2
TimeoutStopSec=30
KillSignal=SIGTERM

[Install]
WantedBy=multi-user.target
