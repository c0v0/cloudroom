# LiveKit configuration for CloudRoom
# Install: sudo install -m 0640 deploy/livekit/livekit.yaml.example /etc/livekit.yaml
# Generate keys with:
#   openssl rand -hex 32   (api_key)
#   openssl rand -hex 32   (api_secret)
# Use the SAME key/secret as media.livekit_api_key / media.livekit_api_secret
# in /etc/cloudroom/config.toml. The browser never receives the secret: the
# backend mints short-lived room JWTs at
#   POST /api/v1/rooms/{room_code}/media-token
# and short-lived LiveKit-format TURN credentials at
#   GET /api/v1/rooms/{room_code}/ice-servers
# (room membership required for both).

port: 7880
rtc:
  tcp_port: 7881
  udp_port: 50000
  # LiveKit media is UDP and must NOT go through the HTTP Nginx proxy.
  # Open 7880/tcp, 7881/tcp and 50000-50100/udp in the firewall.
  use_external_ip: true

# LiveKit embedded TURN: relay candidates for clients behind strict NAT.
# This is the ONLY TURN relay CloudRoom uses — the p2p mesh reuses these
# credentials, so an independent coturn is never installed or configured.
# UDP TURN does not need a certificate and covers most NAT cases; the relay
# ports are separate from the RTC UDP range above.
turn:
  enabled: true
  domain: lk.example.com   # used for the optional TLS TURN below
  udp_port: 3478
  relay_range_start: 50200
  relay_range_end: 50250

keys:
  # CHANGE_ME: same value as media.livekit_api_key in cloudroom config.
  CHANGE_ME_api_key: CHANGE_ME_api_secret

logging:
  level: info

# TLS for the signaling endpoint (wss://lk.example.com): LiveKit itself does
# not terminate TLS, so put it behind Nginx/Caddy with the same pattern as
# the CloudRoom Nginx example (proxy 7880 with Upgrade headers for WSS).
# LiveKit UDP media always flows directly.
#
# If you need TURN over TLS as well (e.g. UDP 3478 is blocked by a firewall),
# give the embedded TURN server a certificate:
#
# turn:
#   tls_port: 5349
#   cert_file: /etc/letsencrypt/live/turn.example.com/fullchain.pem
#   key_file: /etc/letsencrypt/live/turn.example.com/privkey.pem
# (cert_file/key_file also enable TLS termination for the TURN listener.)
