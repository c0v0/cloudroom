# LiveKit systemd unit for CloudRoom (large-room profile)
# Install: sudo install -m 0644 livekit/livekit-server.service.example \
#            /etc/systemd/system/livekit-server.service
#          sudo systemctl daemon-reload
#          sudo systemctl enable --now livekit-server
[Unit]
Description=LiveKit WebRTC SFU server (CloudRoom)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=livekit
Group=livekit
ExecStartPre=/bin/sh -c '! grep -Eq "^[[:space:]]*CHANGE_ME" /etc/livekit.yaml'
ExecStart=/usr/local/bin/livekit-server --config /etc/livekit.yaml
Restart=on-failure
RestartSec=3
LimitNOFILE=1048576
# LiveKit needs large UDP buffers for media relay
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
