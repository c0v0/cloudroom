# CloudRoom — Nginx site (example)
# Public TLS terminates here. The backend listens ONLY on loopback/Unix
# socket; it is never exposed directly. Nginx proxies HTTP/WSS control plane
# only — WebRTC UDP media goes P2P or to LiveKit directly, never
# through Nginx.
#
# Copy to /etc/nginx/sites-available/cloudroom.conf, adjust placeholders,
# then: sudo nginx -t && sudo systemctl reload nginx

# HTTP -> HTTPS redirect + ACME challenge (certbot handles issuance).
server {
    listen 80;
    listen [::]:80;
    server_name chat.example.com;          # <-- your domain
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        access_log off;
    return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name chat.example.com;          # <-- your domain

    # certbot-managed certificates; adjust if you manage certs yourself.
    ssl_certificate     /etc/letsencrypt/live/chat.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    server_tokens off;
    ssl_prefer_server_ciphers off;

    # Security headers.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' wss: https:; media-src 'self' blob:; script-src 'self'; frame-ancestors 'none'" always;
    add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;

    # Static frontend (independent build; npm run build output).
    access_log off; # query strings can contain invite/bootstrap tokens
    root /var/www/cloudroom;
    index index.html;

    # LiveKit server API/ Twirp is internal-only; fail closed if requested publicly.
    location /twirp {
        return 404;
    }

    # SPA routing: room URLs live at the root (/<room_code>).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API + WebSocket proxy to the loopback backend.
    location /api/v1/ {
        proxy_pass http://127.0.0.1:8080;          # or http://unix:/run/cloudroom/cloudroom.sock;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite, do not append: the backend trusts only this proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        # WebSocket upgrade (the /ws endpoint lives under /api/v1/).
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        # Avatar uploads: 2 MiB limit + multipart overhead.
        client_max_body_size 3m;
        # Never cache API responses.
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src 'self' wss: https:; media-src 'self' blob:; script-src 'self'; frame-ancestors 'none'" always;
        add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }
    location ~ /\. { deny all; }

    # Explicitly never proxy WebRTC media ports (P2P/LiveKit are
    # reached by browsers directly on their own ports).
}
