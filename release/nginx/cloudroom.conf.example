# CloudRoom — Nginx site (example)
# Public TLS terminates here. The backend listens ONLY on loopback/Unix
# socket; it is never exposed directly. Nginx proxies HTTP/WSS control plane
# only — WebRTC UDP media goes P2P or to LiveKit directly, never
# through Nginx.
#
# Copy to /etc/nginx/sites-available/cloudroom.conf, adjust placeholders,
# then: sudo nginx -t && sudo systemctl reload nginx

# HTTP -> HTTPS redirect + ACME challenge (certbot handles issuance).
server {
    listen 80;
    listen [::]:80;
    server_name chat.example.com;          # <-- your domain
    server_tokens off;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        access_log off;
    return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # nginx >= 1.25：http2 用独立指令（listen ... http2 已废弃）。
    http2 on;
    server_name chat.example.com;          # <-- your domain

    # certbot-managed certificates; adjust if you manage certs yourself.
    # 边缘限流（依赖 /etc/nginx/conf.d/cloudroom-limits.conf 中的 zone 定义）。
    limit_conn cloudroom_conn 20;
    ssl_certificate     /etc/letsencrypt/live/chat.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/chat.example.com/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_stapling on;
    ssl_stapling_verify on;
    server_tokens off;
    ssl_prefer_server_ciphers off;

    # Security headers.
    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;
    add_header X-Frame-Options "DENY" always;
    add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; media-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'" always;
    add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;

    # 文本资源压缩（未安装 brotli 模块时的兜底）。
    gzip on;
    gzip_vary on;
    gzip_min_length 1024;
    gzip_comp_level 5;
    gzip_types text/plain text/css application/javascript application/json application/manifest+json image/svg+xml;

    # Static frontend (independent build; npm run build output).
    access_log off; # query strings can contain invite/bootstrap tokens
    root /var/www/cloudroom;
    index index.html;

    # 入口文件不缓存，避免发版后引用已删除的 hash 资源。
    location = /index.html {
        expires -1;
    }

    location = /sw.js {
        expires -1;
    }

    # LiveKit server API/ Twirp is internal-only; fail closed if requested publicly.
    location /twirp {
        return 404;
    }

    # SPA routing: room URLs live at the root (/<room_code>).
    location / {
        try_files $uri $uri/ /index.html;
    }

    # 带 hash 的构建产物：内容不可变，长缓存；仍需重复安全头（add_header 继承规则）。
    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable" always;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
    }

    # 房间控制面 WebSocket：只有这个端点需要长连接与升级头。
    location ~ ^/api/v1/rooms/[^/]+/ws$ {
        limit_req zone=cloudroom_ws burst=5 nodelay;
        limit_conn cloudroom_ws_conn 8;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
    }

    # 登录/注册单独限流（cloudroom_auth zone，见 cloudroom-limits.conf.example）。
    location ~ ^/api/v1/auth/(login|register)$ {
        limit_req zone=cloudroom_auth burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite, do not append: the backend trusts only this proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }

    location /api/v1/ {
        limit_req zone=cloudroom_api burst=60 nodelay;
        proxy_pass http://127.0.0.1:8080;          # or http://unix:/run/cloudroom/cloudroom.sock;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Overwrite, do not append: the backend trusts only this proxy.
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_buffering off;
        # 普通 API 不需要长连接超时；上传/导出等仍在 60s 内完成。
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
        # 头像 2 MiB / 成员截图 2 MiB / 管理员附件 5 MiB + multipart 开销。
        client_max_body_size 8m;
        # Never cache API responses.
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
        add_header X-Frame-Options "DENY" always;
        add_header Content-Security-Policy "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; connect-src 'self'; media-src 'self' blob:; script-src 'self' 'wasm-unsafe-eval' blob:; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; object-src 'none'; form-action 'self'" always;
        add_header Permissions-Policy "microphone=(self), camera=(), geolocation=()" always;
        proxy_hide_header Cache-Control;
        add_header Cache-Control "no-store" always;
    }
    # LiveKit 信令（WSS）：浏览器直连 /rtc，必须保留 WebSocket 升级头。
    location /rtc/ {
        limit_req zone=cloudroom_rtc burst=10 nodelay;
        limit_conn cloudroom_ws_conn 8;
        proxy_pass http://127.0.0.1:7880;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        client_max_body_size 1m;
    }

    location ~ /\. { deny all; }

    # Explicitly never proxy WebRTC media ports (P2P/LiveKit are
    # reached by browsers directly on their own ports).
}
